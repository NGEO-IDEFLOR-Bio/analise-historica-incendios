# ==============================================================================
# Exemplo de Configurações de Ambiente - Análise Histórica de Incêndios
# Copie para .env e preencha com suas credenciais locais
# ==============================================================================

# Google Earth Engine (GEE)
GEE_PROJECT_ID=seu-projeto-gcp
GEE_CREDENTIALS_JSON=secrets/sua-chave-service-account.json

# NASA FIRMS (Focos ativos de calor - Opcional)
FIRMS_API_KEY=sua_chave_firms_aqui

# Configurações de Execução
DEBUG=False
